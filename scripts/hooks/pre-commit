#!/bin/sh
# Git pre-commit hook for torn
# Runs formatting checks, linter (go vet), and race tests before committing.

set -e

echo "==> Running torn pre-commit quality checks (lint & tests)..."

# Ensure execution from repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

if command -v make >/dev/null 2>&1; then
    make check
else
    echo "Checking formatting..."
    UNFORMATTED=$(gofmt -l . | grep -v '^.git' || true)
    if [ -n "$UNFORMATTED" ]; then
        echo "================================================================" >&2
        echo "[COMMIT REJECTED] Unformatted Go files detected:" >&2
        echo "$UNFORMATTED" >&2
        echo "Please format your code before committing: gofmt -w ." >&2
        echo "================================================================" >&2
        exit 1
    fi

    echo "Running go vet..."
    if ! go vet ./...; then
        echo "================================================================" >&2
        echo "[COMMIT REJECTED] go vet found issues." >&2
        echo "================================================================" >&2
        exit 1
    fi

    echo "Running tests with race detector..."
    if ! go test -race ./...; then
        echo "================================================================" >&2
        echo "[COMMIT REJECTED] Tests failed or race condition detected." >&2
        echo "================================================================" >&2
        exit 1
    fi
fi

echo "==> Pre-commit checks passed cleanly."
exit 0
